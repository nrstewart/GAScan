# Google Apps Script DevContainer Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# CLASP (Google Apps Script CLI) Configuration
# =============================================================================

# Google OAuth Client ID for CLASP authentication
# Get this from Google Apps Script Settings: https://script.google.com/home/usersettings
# GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# Google OAuth Client Secret for CLASP authentication
# GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Google Apps Script Project ID (optional, can be set in .clasp.json instead)
# CLASP_SCRIPT_ID=your-apps-script-project-id

# =============================================================================
# Gemini AI Configuration
# =============================================================================

# Gemini API Key for AI-assisted coding
# Get your API key from: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (optional, defaults to gemini-pro)
# GEMINI_MODEL=gemini-pro

# =============================================================================
# 1Password CLI Configuration
# =============================================================================

# 1Password account identifier (optional)
# OP_ACCOUNT=your-1password-account-id

# 1Password vault for storing secrets (optional)
# OP_VAULT=your-vault-name

# =============================================================================
# Development Environment
# =============================================================================

# Node environment
NODE_ENV=development

# Enable debug logging for CLASP
# CLASP_DEBUG=true

# TypeScript compiler options override (optional)
# TS_NODE_COMPILER_OPTIONS={"module":"commonjs"}

# =============================================================================
# Container-Specific Variables
# =============================================================================

# Flag to indicate running in DevContainer (set automatically)
CLASP_CONTAINER=true

# =============================================================================
# Security Notes
# =============================================================================
#
# 1. NEVER commit .env files to version control
# 2. Use 1Password CLI to inject secrets: op run -- npm run dev
# 3. For CLASP authentication, you may need to run 'clasp login' interactively
# 4. Store sensitive values in 1Password and reference them in .env:
#    GEMINI_API_KEY=op://vault/item/field
# 5. The DevContainer mounts ~/.clasprc.json for persistent authentication
#
# Usage Examples:
# ---------------
#
# # Using 1Password CLI to inject secrets and run development
# op run -- npm run dev
#
# # Authenticate with CLASP (interactive, run once)
# clasp login
#
# # Deploy with environment variables
# npm run clasp:deploy
#
# =============================================================================
